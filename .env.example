# Use Our Jam's isolated development branch locally. No real values belong here.
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/neondb
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/neondb
PUBLIC_ORIGIN=http://localhost:5173
PORT=3001
# Random secret at least 32 characters, exchanged for a 12-hour HttpOnly operator session.
OPERATOR_TOKEN=
RUN_MIGRATIONS=0

# Disabled until rights, credentials, storage and spend are explicitly approved.
GENERATION_ENABLED=0
RUN_INLINE_GENERATION=0
STABILITY_API_KEY=
GENERATION_RIGHTS_ACK=
GENERATION_MAX_JOB_CENTS=
GENERATION_EVENT_BUDGET_CENTS=
GENERATION_TOTAL_BUDGET_CENTS=
GENERATION_DURATION_SECONDS=90
GENERATION_PRICE_VERIFIED_UNTIL=
# A private, Our Jam-specific S3-compatible bucket. No public bucket policy.
MEDIA_BUCKET=
MEDIA_REGION=
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=

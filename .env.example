# Use only Our Jam's isolated database. Never commit actual values.
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/neondb
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/neondb
PUBLIC_ORIGIN=http://localhost:5173
PORT=3001
OPERATOR_TOKEN=
RUN_MIGRATIONS=0

# Run real queue processing with a hard $0 budget. No provider POST can occur.
GENERATION_ENABLED=1
RUN_INLINE_GENERATION=1
GENERATION_EVENT_BUDGET_CENTS=0
GENERATION_TOTAL_BUDGET_CENTS=0
GENERATION_DURATION_SECONDS=90
STABLE_AUDIO_KEY=
# STABILITY_API_KEY remains a supported legacy alias.
MUREKA_API_KEY=
MUREKA_MODEL=mureka-9.5
GENERATION_RIGHTS_ACK=
STABLE_AUDIO_MAX_JOB_CENTS=0
STABLE_AUDIO_PRICE_VERIFIED_UNTIL=
MUREKA_MAX_JOB_CENTS=0
MUREKA_PRICE_VERIFIED_UNTIL=
# Private S3-compatible bucket, including Neon Object Storage.
MEDIA_BUCKET=
MEDIA_REGION=
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=

EMAIL_ENABLED=0
EMAIL_DELIVERY_ACK=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DATA_KEY=
EMAIL_MAX_SENDS_PER_DAY=
